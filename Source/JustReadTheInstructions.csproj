<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net48</TargetFramework>
		<Version>3.1.0.0</Version>
		<Description>KSP Mod, inspired by OCISLY, as a spiritual successor.</Description>
		<Copyright>MIT</Copyright>
		<KSPBT_ModRoot>$(MSBuildThisFileDirectory)../GameData/JustReadTheInstructions</KSPBT_ModRoot>
		<KSPBT_ModPluginFolder>Plugins</KSPBT_ModPluginFolder>
	</PropertyGroup>

	<!-- KSPBT's CKAN auto-install uses a shell input redirect that cmd.exe can't parse, so it silently does nothing on Windows -->
	<PropertyGroup Condition="$([MSBuild]::IsOsPlatform('Windows'))">
		<KSPBT_InstallCKANDependencies>false</KSPBT_InstallCKANDependencies>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="KSPBuildTools" Version="1.1.1" />
	</ItemGroup>

	<ItemGroup>
		<ModReference Include="HullcamVDSContinued">
			<DLLPath>GameData/HullCameraVDS/Plugins/HullcamVDSContinued.dll</DLLPath>
			<CKANIdentifier>HullcamVDSContinued</CKANIdentifier>
			<Visible>false</Visible>
		</ModReference>
	</ItemGroup>

	<ItemGroup>
		<KSPVersionFile Include=".">
			<Destination>$(KSPBT_ModRoot)/JustReadTheInstructions.version</Destination>
			<Name>Just Read The Instructions</Name>
			<URL>https://raw.githubusercontent.com/RELMYMathieu/JustReadTheInstructions/main/GameData/JustReadTheInstructions/JustReadTheInstructions.version</URL>
			<Download>https://github.com/RELMYMathieu/JustReadTheInstructions/releases/latest</Download>
			<KSP_Version>1.12.5</KSP_Version>
			<KSP_Version_Min>1.12.0</KSP_Version_Min>
			<KSP_Version_Max>1.12.99</KSP_Version_Max>
		</KSPVersionFile>
	</ItemGroup>

</Project>
